  "head": "",
  "format": "<template>\n  <div>\n    <div style=\"width:100%; aspect-ratio:4/3; background:#000; border-radius:6px; overflow:hidden\">\n      <img :src=\"src\" @error=\"retry\" alt=\"Pi camera\" style=\"width:100%; height:100%; object-fit:contain\">\n    </div>\n    <div style=\"font-size:12px; opacity:0.7; margin-top:4px\">\n      Live picture from the Pi camera ({{ pi }}:8080/camera.mjpg).\n      If the Pi gets a new IP, change it in this node.\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() { return { pi: \"10.25.155.231\", n: 0 } },\n  computed: { src() { return \"http://\" + this.pi + \":8080/camera.mjpg?n=\" + this.n } },\n  methods: { retry() { setTimeout(() => { this.n++ }, 2000) } }   // bridge restarted: try again\n}\n</script>",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "className": "",
