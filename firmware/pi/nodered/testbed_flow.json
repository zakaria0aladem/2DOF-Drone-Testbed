 {
  "id": "f_tel",
  "type": "function",
  "z": "tb_flow",
  "x": 100,
  "y": 960,
  "wires": [
   [
    "c_pitch"
   ],
   [
    "c_yaw"
   ],
   [
    "t_pitch"
   ],
   [
    "t_ptgt"
   ],
   [
    "t_pout"
   ],
   [
    "t_encp"
   ],
   [
    "t_yaw"
   ],
   [
    "t_ytgt"
   ],
   [
    "t_yout"
   ],
   [
    "t_yerr"
   ],
   [
    "ga_m2"
   ],
   [
    "ga_m1"
   ],
   [
    "ga_m3"
   ],
   [
    "ga_m4"
   ],
   [
    "t_link"
   ]
  ],
  "name": "split telemetry (10 Hz)",
  "func": "// Runs for every telemetry message (50 per second).\n// Charts and texts only need ~10 updates a second, so drop the rest.\nconst now = Date.now();\nif (now - (context.get(\"last\") || 0) < 100) return null;\ncontext.set(\"last\", now);\n\nconst t = msg.payload;          // JSON object from testbed/tel\nconst f = v => (v === undefined) ? \"-\" : Number(v).toFixed(1);\nconst m = k => (t[k] !== undefined) ? t[k] : ((k === \"m2\" || k === \"m3\") ? t.left_us : t.right_us);\nreturn [\n    [ {topic: \"measured (IMU)\", payload: t.pitch},\n      {topic: \"reference\", payload: t.target},\n      {topic: \"measured (encoder)\", payload: t.enc_pitch} ],      // 1 pitch chart\n    [ {topic: \"measured\", payload: t.enc_yaw},\n      {topic: \"reference\", payload: t.yaw_target} ],              // 2 yaw chart\n    {payload: f(t.pitch)}, {payload: f(t.target)},                // 3, 4\n    {payload: f(t.output)}, {payload: f(t.enc_pitch)},            // 5, 6\n    {payload: f(t.enc_yaw)}, {payload: f(t.yaw_target)},          // 7, 8\n    {payload: f(t.yaw_out)},                                      // 9\n    {payload: t.yaw_target === undefined ? \"-\" : f(t.yaw_target - t.enc_yaw)},  // 10\n    {payload: m(\"m2\")}, {payload: m(\"m1\")}, {payload: m(\"m3\")}, {payload: m(\"m4\")},  // 11-14\n    {payload: t.link_lost ? \"LOST (pitch target back to 0)\" : \"ok\"}  // 15\n];",
  "outputs": 15,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": []
 },
