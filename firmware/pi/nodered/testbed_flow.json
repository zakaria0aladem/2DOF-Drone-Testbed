 {
  "id": "f_status",
  "type": "function",
  "z": "tb_flow",
  "x": 820,
  "y": 1380,
  "wires": [
   [
    "t_board"
   ],
   [
    "t_state"
   ],
   [
    "t_mode"
   ],
   [
    "t_log"
   ]
  ],
  "name": "split status",
  "func": "const s = msg.payload;          // JSON object from testbed/status (2 per second)\nif (s.bridge !== \"online\") return [{payload: \"bridge OFFLINE\"}, null, null, null];\nreturn [\n    {payload: s.board_connected ? \"connected\" : \"NOT responding\"},\n    {payload: s.state},\n    {payload: s.mode === \"camera\" ? \"CAMERA TRACKING\" : \"MANUAL\"},\n    {payload: s.logging ? (\"recording \" + s.log_file + \" (\" + s.log_rows + \" rows)\") : \"off\"}\n];",
